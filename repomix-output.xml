        proposedChangesList.appendChild(row);
      });

      matchResultPreview.style.display = 'block';
    } catch (err) {
      alert('Lỗi phân tích: ' + err.message);
    } finally {
      analyzeMatchAiBtn.innerText = '⚡ AI Phân Tích & Tính Điểm Điều Chỉnh';
