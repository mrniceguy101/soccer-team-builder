:root {
  --bg-color: #121212;
  --panel-bg: #1e1e1e;
  --panel-border: #333333;
  --text-main: #e0e0e0;
  --text-muted: #888888;
  --accent: #3b82f6;
  --accent-hover: #2563eb;
  --danger: #ef4444;
  --success: #22c55e;
  --warning: #d97706;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 24px;
  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.app-wrapper {
  max-width: 1100px;
